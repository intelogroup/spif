# ==============================================================================
# SPIF Monorepo Unified Gitignore
# ==============================================================================

# OS / System Exclusions
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Environment & Private Variables (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.sig.key

# Python Exclusions
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
.ruff_cache/

# Node.js / TypeScript Exclusions
node_modules/
/node_modules/
package-lock.json
/spfx/packages/spfx-js/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Rust / Cargo Exclusions
spif-rust/target/

# Tauri / Desktop Build Exclusions
spif-desktop/src-tauri/target/
spif-desktop/node_modules/
spif-desktop/package-lock.json

# Temporary / Sandbox Files
/sample_corrupted.spif
/sample_tampered.spif
.bin/
experiments/hard_bench_synthetic/
experiments/**/*.sif
experiments/**/*.spif

# Generated graph/bench output (not source, regenerate locally)
spif/graphify-out/
graphify-out/
spif/results/*.txt

# Claude agent config
.claude/
