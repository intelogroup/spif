{
  "name": "spfx-js",
  "version": "1.0.0",
  "description": "TypeScript/Node.js implementation of SPIF — cryptographically signed, tamper-evident provenance for AI outputs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai", "llm", "provenance", "signatures", "audit", "binary-format",
    "agents", "compliance", "ed25519", "tamper-evident"
  ],
  "license": "MIT",
  "author": "Brainex <hello@brainex.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainex-ai/spif"
  },
  "homepage": "https://github.com/brainex-ai/spif#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "SPIF_PYTHON=$(which python3) node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "cbor-x": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  }
}
